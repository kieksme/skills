    {
      "name": "kieksme-contabo-mcp",
      "displayName": "Contabo MCP",
      "source": {
        "source": "git-subdir",
        "url": "https://github.com/kieksme/mcp-contabo.git",
        "path": "contabo-mcp"
      },
      "description": "Manage Contabo VPS/VDS instances, images, snapshots, networking, DNS, object storage, secrets, domains, and tags from Claude Code.",
      "version": "1.5.2",
      "author": {
        "name": "kieksme",
        "url": "https://github.com/kieksme"
      },
      "homepage": "https://github.com/kieksme/mcp-contabo",
      "repository": "https://github.com/kieksme/mcp-contabo",
      "license": "GPL-3.0-or-later",
      "keywords": [
        "mcp",
        "contabo",
        "cloud",
        "vps",
        "infrastructure"
      ],
      "category": "cloud",
      "strict": false,
      "userConfig": {
        "client_id": {
          "type": "string",
          "title": "Contabo customer ID",
          "description": "The OAuth customer ID from the Contabo Control Panel.",
          "required": true
        },
        "client_secret": {
          "type": "string",
          "title": "Contabo client secret",
          "description": "The OAuth client secret from the Contabo Control Panel.",
          "required": true,
          "sensitive": true
        },
        "api_user": {
          "type": "string",
          "title": "Contabo API user",
          "description": "The API user email from the Contabo Control Panel.",
          "required": true,
          "sensitive": true
        },
        "api_password": {
          "type": "string",
          "title": "Contabo API password",
          "description": "The API password from the Contabo Control Panel.",
          "required": true,
          "sensitive": true
        }
      },
      "mcpServers": {
        "contabo": {
          "type": "stdio",
          "command": "npx",
          "args": ["-y", "@kieksme/contabo-mcp@1.5.2"],
          "env": {
            "CONTABO_CLIENT_ID": "${user_config.client_id}",
            "CONTABO_CLIENT_SECRET": "${user_config.client_secret}",
            "CONTABO_API_USER": "${user_config.api_user}",
            "CONTABO_API_PASSWORD": "${user_config.api_password}"
          }
        }
      }
    },
    {
      "name": "kieksme-listmonk-mcp",
      "displayName": "Listmonk MCP",
      "source": {
        "source": "github",
        "repo": "kieksme/mcp-listmonk"
      },
      "description": "Manage Listmonk newsletters, subscribers, campaigns, templates, and settings through MCP.",
      "version": "1.3.0",
      "author": {
        "name": "kieksme",
        "url": "https://github.com/kieksme"
      },
      "homepage": "https://github.com/kieksme/mcp-listmonk",
