        "mcp",
        "listmonk",
        "newsletter",
        "email",
        "subscribers"
      ],
      "category": "marketing",
      "strict": false,
      "userConfig": {
        "url": {
          "type": "string",
          "title": "Listmonk URL",
          "description": "Base URL of your Listmonk instance, for example https://newsletter.example.com.",
          "required": true
        },
        "api_user": {
          "type": "string",
          "title": "Listmonk API user",
          "description": "The Listmonk API user name.",
          "required": true
        },
        "api_token": {
          "type": "string",
          "title": "Listmonk API token",
          "description": "The Listmonk API token for the selected user.",
          "required": true,
          "sensitive": true
        }
      },
      "mcpServers": {
        "listmonk": {
          "type": "stdio",
          "command": "npx",
          "args": ["-y", "@kieksme/listmonk-mcp@1.3.0"],
          "env": {
            "LISTMONK_URL": "${user_config.url}",
            "LISTMONK_API_USER": "${user_config.api_user}",
            "LISTMONK_API_TOKEN": "${user_config.api_token}"
          }
        }
      }
